# Document Intelligence Configuration
# Copy to .env and fill in values

# Application
APP_NAME=document-intelligence
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-32-char-minimum-key

# Database
POSTGRES_PASSWORD=change-this-to-a-secure-password
DATABASE_URL=postgresql+asyncpg://docintel:POSTGRES_PASSWORD@localhost:5432/document_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=documents
MINIO_SECURE=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Model
MODEL_PATH=models/best_model
OCR_ENGINE=paddleocr
OCR_LANG=en

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]

# Worker
WORKER_CONCURRENCY=2
WORKER_TIMEOUT=300
MODEL_WARMUP=true

# Monitoring
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=document-intelligence

# GPU
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ARCH_LIST=7.0;7.5;8.0;8.6

# Demo
STREAMLIT_PORT=8501

# Auth
API_KEYS=your-api-key-1,your-api-key-2
JWT_SECRET=change-this-to-a-secure-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60